# #408: this container's own proxy_set_header used to unconditionally overwrite X-Real-IP with
# $remote_addr before forwarding to the backend -- destroying the correct client IP Railway's edge
# already hands us in $http_x_real_ip (confirmed live, including against a deliberately forged
# X-Real-IP: the edge overwrites client-supplied values, it doesn't preserve them). But trusting
# $http_x_real_ip just because it's *present* would be wrong for the self-hosted/docker-compose
# topology: there's no edge in front of nginx there, so a direct client can set that header to
# anything it likes, and presence alone can't distinguish "a trusted edge wrote this" from "a
# client wrote this" -- reopening exactly the #336 spoofing hole this file's old behavior avoided.
#
# So the source is not the header alone but the header concatenated with a deployment-time literal
# that only envsubst can set, never a request: ${TRUST_EDGE_REAL_IP} is "1" only on Railway, where
# a trusted edge -- not the client -- writes X-Real-IP before this container ever sees it. Unset
# everywhere else (docker-compose), so $remote_addr is used unconditionally there, matching this
# file's original behavior for that topology exactly.
#
# The ":" delimiter is load-bearing, not decoration: without it, an unset flag concatenated with a
# client-forged header that happens to start with "1" (e.g. "172.16.0.5") could false-match a naive
# "^1" prefix check. With it, only an exact "1:" prefix -- which only the deploy-time literal can
# produce -- matches; nothing a client sends can ever contain that literal prefix on its own.
map "${TRUST_EDGE_REAL_IP}:$http_x_real_ip" $client_ip {
    default            $remote_addr;
    "~^1:(?<v>.+)$"    $v;
}

# Railway terminates TLS at its edge and forwards plain HTTP to this container, so the request nginx
# sees is never https: $scheme is a lie about the browser hop, and everything below that cares about
# the real protocol has to read the edge's X-Forwarded-Proto instead. This map is the single place
# that value is interpreted -- both the HSTS header and the header we hand the backend derive from
# it, so the two cannot drift apart (they had: the /api/ proxy used to overwrite the edge's value
# with $scheme, telling the backend every request arrived over plain http).
#
# The regex, not a pass-through, is the point. Whatever lands here is forwarded to the backend, and
# the first feature to build an absolute URL, set a secure cookie or issue a proto-aware redirect
# from it must not be handed an arbitrary client-supplied string. Only http or https can come out;
# anything else falls back to the scheme actually spoken to this container. Match is case-sensitive
# on purpose -- ~* would capture "HTTPS" verbatim and then miss the exact-match key in $hsts_header.
#
# Leftmost wins if the header ever arrives as a chain ("https, http"): for X-Forwarded-Proto the
# first entry is the original client hop. That is the mirror image of the right-to-left walk
# ClientIpResolver does over X-Forwarded-For (#336), where the *last* entry is the one a trusted
# proxy wrote -- the two conventions genuinely differ, so the asymmetry is not a bug.
#
# No edge header at all (local docker compose, which publishes 3000:80 straight at nginx with
# nothing in front of it) means no match, so $forwarded_proto is just the real scheme: http.
map $http_x_forwarded_proto $forwarded_proto {
    "~^(?<edge_proto>https?)\b"  $edge_proto;
    default                      $scheme;
}

# nginx skips an add_header whose value is empty, so a local docker compose run over http sends no
# HSTS at all.
#
# $hsts_header, $forwarded_proto and $http_x_forwarded_proto survive the Dockerfile's envsubst only
# because it is given an explicit variable list (envsubst '$BACKEND_URL'). Dropping that list would
# blank all three; nginx-serving.test.ts pins the list against exactly that.
map $forwarded_proto $hsts_header {
    https   "max-age=31536000; includeSubDomains";
    default "";
}

# Cache policy is decided here rather than in a `location` for the same reason the headers below
# live in `server`: a location that declares an add_header replaces the whole inherited set, so an
# add_header Cache-Control under /assets/ would strip the CSP from every file the app runs on. The
# `expires` directive dodges that but cannot emit `immutable`; mapping the value and adding it once
# in `server` gives us both.
map $uri $cache_control {
    # Spring Security already sends "no-cache, no-store, max-age=0, must-revalidate" on its own.
    # nginx omits an add_header whose value is empty (the trick the HSTS line above relies on), so
    # this leaves the API's headers exactly as the backend wrote them -- anything we added here
    # would either duplicate the header or weaken it into something a browser may store on disk.
    ~^/api/     "";

    # Vite content-hashes these, so the URL changes whenever the bytes do: they can never go stale
    # and never need revalidating. `immutable` is what stops a reload from re-checking them.
    ~^/assets/  "public, max-age=31536000, immutable";

    # index.html (directly and through the SPA fallback) names the hashed bundles, so it is the one
    # file a deploy has to invalidate. no-cache still caches -- it revalidates before use -- so the
    # new build lands on the next navigation instead of waiting out a heuristic freshness window.
    default     "no-cache";
}

server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    # The nginx:alpine base image ships gzip commented out (verified on 1.31.2), so until now every
    # cold load pulled the whole bundle uncompressed. text/html is deliberately absent from the list
    # below: it is compressed implicitly whenever gzip is on, and is the one type gzip_types cannot
    # control. application/manifest+json is present because it is *not* in nginx's mime.types at all
    # -- the manifest location further down declares it, so gzip_types has to name it too.
    #
    # Both JavaScript media types are listed on purpose. 1.31.2's mime.types maps .js to
    # application/javascript, but nginx has moved on this before; naming only the current one means
    # a future base-image bump silently stops compressing the largest file we serve, with no test
    # anywhere going red.
    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_comp_level 5;

    # Not boilerplate: the default (`off`) skips compression for any request carrying a Via header,
    # i.e. potentially everything that reaches us through Railway's edge proxy. Left at the default
    # this change would compress perfectly under local docker compose and nothing in production.
    gzip_proxied any;

    gzip_types application/javascript text/javascript text/css application/json image/svg+xml application/manifest+json;

    # The JWT lives in localStorage and is a 24h stateless token with no revocation (#293), so an
    # XSS foothold would mean a day-long session nobody can kill. The CSP is the mitigation for
    # that trade-off. Every source below is something the app actually loads:
    #   script-src   accounts.google.com/gsi/client -- the GIS script in index.html. No
    #                'unsafe-inline': Vite emits an external module bundle, no inline scripts.
    #   style-src    fonts.googleapis.com (the Nunito stylesheet) and gsi/style (styles GIS
    #                injects into our page). 'unsafe-inline' is unavoidable -- CSP governs inline
    #                style *attributes*, and the progress/genre bars compute their width at render
    #                time (style={{ width: `${pct}%` }}), so they can be neither nonced nor hashed.
    #   font-src     fonts.gstatic.com -- the font files that stylesheet pulls.
    #   img-src      image.tmdb.org (every poster, still, profile photo and provider logo comes
    #                from TmdbClient) plus data: for the inline chevron SVG in index.css.
    #   connect-src  'self' for /api/, gsi/ for the sign-in button's own XHRs.
    #   frame-src    gsi/ -- the Google button is an iframe, and it only mounts when signed out.
    #
    # Keep the CSP on one physical line: nginx allows a quoted string to span lines, but the
    # newline ends up inside the header value.
    #
    # These live in `server` on purpose. A `location` that declares its own add_header *replaces*
    # the inherited set rather than merging with it -- so adding, say, an add_header Cache-Control
    # to the manifest location below would silently strip every header here from that response.
    # `always` so they ride on error responses too, not just 2xx/3xx.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://image.tmdb.org; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security $hsts_header always;

    # Value comes from the $cache_control map above. Unlike the five headers above it, this one is
    # deliberately *not* `always`: without it add_header applies to 2xx/3xx only, which is exactly
    # the set that should carry a cache policy. A year-long policy on an error is how a bad deploy
    # pins a 404 in someone's browser.
    add_header Cache-Control $cache_control;

    # #415: ${BACKEND_URL}'s host resolves once, at nginx worker startup, when it's the literal
    # target of proxy_pass -- confirmed live: after #408/#414 pointed it at the backend's Railway
    # private domain, a backend-only restart left nginx dialing the address that domain resolved to
    # *before* the restart until nginx itself was redeployed. A `resolver` plus a variable-based
    # proxy_pass forces per-request, TTL-bound re-resolution instead. `${NGINX_RESOLVERS}` is
    # derived in the Dockerfile from this container's own /etc/resolv.conf -- see the comment there
    # for why it isn't hardcoded and can't end up pointed at a resolver blind to Railway's private
    # `*.railway.internal` names. `valid=10s` overrides whatever TTL the upstream DNS answer itself
    # carries (Docker's embedded resolver was observed handing out one far longer than useful for
    # noticing a redeploy) with a bound short enough that a restart is noticed quickly without
    # querying on every single request.
    resolver ${NGINX_RESOLVERS} valid=10s;
    resolver_timeout 5s;

    location /api/ {
        # $request_uri, not a literal /api/ suffix -- this location's prefix maps to itself
        # (/api/foo -> /api/foo), which is exactly what $request_uri reproduces, verified against
        # the static form byte for byte including the query string. This is NOT the same as
        # appending a URI to a variable target: nginx does not do prefix-replacement when
        # proxy_pass's target contains a variable, so `proxy_pass $backend_upstream/api/;` (the
        # naive translation of the line above) sends a literal "/api/" for every request regardless
        # of what was actually requested -- silently discarding the rest of the path and the entire
        # query string. Confirmed by testing before writing this line, not assumed.
        set $backend_upstream ${BACKEND_URL};
        proxy_pass $backend_upstream$request_uri;
        proxy_ssl_server_name on;

        # #408: both set to $client_ip (the map above), not $remote_addr / $proxy_add_x_forwarded_for
        # -- nginx has already resolved the one correct value (or fallen back to its own peer), so
        # forwarding the edge's own irrelevant internal hop chain on top of it serves nothing. A
        # single-entry X-Forwarded-For is also exactly the shape ClientIpResolver's existing
        # right-to-left walk (#336) already handles correctly, so no backend change was needed.
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;

        # $scheme here would be a lie: TLS ends at Railway's edge, so it is always http inside this
        # container and the backend would be told plain http even for an https browser hop. Forward
        # what the edge saw (normalized by the $forwarded_proto map at the top of this file), which
        # degrades to the real scheme when there is no edge in front of us.
        proxy_set_header X-Forwarded-Proto $forwarded_proto;

        # Spring Security sends both of these by default and add_header appends rather than
        # replaces, so without this every API response would carry each header twice.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
    }

    # nginx's stock mime.types has no mapping for .webmanifest, so without this the manifest
    # is served as application/octet-stream. An exact-match location also keeps it out of the
    # SPA fallback below, which would otherwise answer a missing manifest with 200 + index.html.
    # The types block is scoped to this location, so it does not shadow the global type map.
    location = /manifest.webmanifest {
        types { application/manifest+json webmanifest; }
    }

    # The hashed bundle must never reach the SPA fallback below. A missing /assets/ file would
    # otherwise answer 200 + index.html and the browser would try to parse a page of HTML as
    # JavaScript -- and now that this prefix carries a year-long immutable policy, it would cache
    # that answer. =404 makes a bad deploy fail loudly, and an error carries no cache policy at all
    # (the Cache-Control add_header above is not `always`), so nothing about it persists.
    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
